  "notes": {
    "--canvas": "Neutral outer shell without a warm or cool cast; shared runtime foundation.",
    "--canvas-depth": "Subtle darker endpoint for the outer shell's vertical depth gradient; never a page or working-surface fill.",
    "--surface": "Subtle grouping; not a requirement to put every row on a card.",
    "--line": "Decorative structural divider only; never the sole meaningful field boundary.",
    "--soft-line": "Low-emphasis internal divider; not an accessibility indicator.",
    "--line-strong": "Meaningful boundary against supported neutral backgrounds.",
    "--focus-halo": "Low-emphasis outer layer of the two-layer focus treatment; the inner focus-ring remains the decisive boundary.",
    "--danger-hover": "Hover surface for destructive controls; interaction changes the surface and never adds link underlining.",
    "--danger-pressed": "Pressed surface for destructive controls with retained danger-ink contrast.",
    "--danger-focus-halo": "Soft outer layer for destructive and invalid focus; pair with danger-ink as the inner boundary.",
    "--notice-info-action": "Dedicated action material for informational notices; notice actions do not reuse ordinary button variants.",
    "--notice-danger-action": "Dedicated destructive action material owned by a danger notice.",
    "--notice-success-action": "Dedicated success action material owned by a success notice.",
    "--notice-attention-action": "Dedicated amber action material owned by an attention notice.",
    "--faint": "Optional metadata only, while retaining 4.5:1 on supported neutral surfaces.",
    "--pressed": "Ordinary control pressed background; state is not conveyed by color alone.",
    "--sidebar-expanded": "Quiet Workbench: compact projects-only navigation selected by the user on 2026-09-20.",
    "--content-project": "Quiet Workbench project list maximum; task documents and settings retain their 720px reading measure.",
    "--panel-inset": "Named 6px optical exception for concentric panel geometry; not part of the spacing scale.",
    "--layer-tooltip": "Local stacking token, not a substitute for native top-layer and modal focus ownership.",
    "--elevation-overlay": "For genuinely overlapping surfaces only; none for ordinary containers.",
    "--duration-enter": "Maximum routine transition duration; disable nonessential motion for reduced motion.",
    "--type-display-size": "Rare onboarding brand moment; never ordinary workspace chrome.",
    "--radius-panel": "Maximum routine compound radius; do not add panels only to use the radius.",
    "--corner-shape-rounded": "Progressive enhancement for every rounded UI contour. Keep border-radius as the complete fallback; true circles and source artwork retain their native geometry.",
    "--sidebar-collapsed": "Preserves the existing 58px collapsed desktop shell.",
    "--page-gutter": "Preserves the current adaptive page gutters during the initial token migration.",
    "--content-wide": "Retained legacy wide content role; ordinary task and settings pages use 720px.",
    "--flood-gradient": "Registered legacy brand-material exception, preserved unchanged; not a neutral control role or a replacement for the supplied raster blobs.",
    "--priority-important": "Legacy priority treatment retained for unmigrated consumers; new anchors use explicit urgency text and the existing supported glyph or semantic ink.",
    "--priority-urgent": "Legacy priority treatment retained for unmigrated consumers; do not use as agent identity or ordinary control color."
  },
  "provenance": {
    "previousSource": "docs/design/tokens.target.json",
    "migratedOn": "2026-09-20",
    "scope": "Shared foundations for the user-approved first UI-kit and three-anchor migration; runtime appearance still requires native verification."
  },
  "brand": {
    "--flood-gradient": "radial-gradient(circle at 34% 28%, #ff765f 0 8%, transparent 38%), radial-gradient(circle at 72% 76%, #7767ff 0 10%, transparent 42%), radial-gradient(circle at 56% 48%, #251629 0 8%, transparent 36%), linear-gradient(145deg, #ffb067 0%, #ff477e 48%, #675cff 100%)",
    "--priority-important": "linear-gradient(90deg, #ffb067 0%, #ff755f 52%, #f14f86 100%)",
    "--priority-urgent": "linear-gradient(90deg, #a9142f 0%, #ff355f 48%, #b735d5 100%)"
  }
