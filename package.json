{
  "name": "flood-md-workspace",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/next"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:packages": "node scripts/build.mjs",
    "build": "npm run build:packages && npm run build --workspace=@flood-md/website",
    "dev": "npm run build:packages && npm run dev --workspace=@flood-md/website",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:next": "npm run build --workspace=@flood-md/next-example",
    "test:packages": "node scripts/package-smoke.mjs",
    "verify": "npm run build && npm run check && npm test && npm run test:packages && npm run test:next && npm run site:check",
    "release:check": "node scripts/release.mjs --check",
    "release:publish": "node scripts/release.mjs",
    "start": "node apps/website/server.mjs",
    "site:check": "node scripts/site-contract.mjs check",
    "site:bundle": "node scripts/site-contract.mjs bundle",
    "site:verify-deploy": "node scripts/site-contract.mjs wait"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.0.8",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
