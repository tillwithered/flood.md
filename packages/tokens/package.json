{
  "name": "@flood-md/tokens",
  "version": "0.2.9",
  "type": "module",
  "description": "Flood semantic design tokens and light/dark themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tillwithered/flood.md.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./foundations": {
      "types": "./dist/foundations.d.ts",
      "import": "./dist/foundations.js"
    },
    "./foundations.css": "./dist/foundations.css",
    "./foundations.manifest.json": "./dist/foundations.manifest.json",
    "./neutral.dark.tokens.json": "./dist/neutral.dark.tokens.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
