{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flood.md",
  "version": "0.1.1",
  "identifier": "io.flood.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release --bin flood-mcp",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "flood.md",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [],
    "createUpdaterArtifacts": true,
    "resources": {
      "../target/release/flood-mcp.exe": "flood-mcp.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0Q0NFNEY3MzlDNDg3NTMKUldSVGg4UTU5K1RNbE05cHRjemNXUjJKVktFSS9wQ2ZrVFJaT3lOcTZ2VCs2ZVVPSlpNWEpacWcK",
      "endpoints": [
        "https://github.com/tillwithered/flood.md/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
