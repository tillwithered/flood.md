{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flood.md",
  "version": "0.1.0",
  "identifier": "io.flood.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "flood.md",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": []
  }
}
