{
  "name": "@flood-md/agent",
  "version": "0.2.11",
  "type": "module",
  "description": "Versioned Flood design instructions for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tillwithered/flood.md.git",
    "directory": "packages/agent"
  },
  "files": [
    "DESIGN.md",
    "SKILL.md",
    "references",
    "lib",
    "dist",
    "knowledge.json",
    "workflows.json",
    "rules.json",
    "manifest.json",
    "README.md"
  ],
  "exports": {
    "./inspect": {
      "types": "./lib/inspect.d.ts",
      "import": "./lib/inspect.mjs"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs"
    },
    "./dist/*": "./dist/*",
    "./DESIGN.md": "./DESIGN.md",
    "./SKILL.md": "./SKILL.md",
    "./manifest.json": "./manifest.json",
    "./rules.json": "./rules.json",
    "./workflows.json": "./workflows.json",
    "./references/*": "./references/*"
  },
  "publishConfig": {
    "access": "public"
  }
}
